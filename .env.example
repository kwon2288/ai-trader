# ── 실행 모드 ─────────────────────────────────────
# dry  = 조회+AI분석만, 주문 절대 안 냄 (처음엔 이걸로)
# mock = 모의투자 계좌로 주문
# live = 실계좌 주문 (+ I_UNDERSTAND_REAL_MONEY=yes)
# 웹 설정 → '실행 모드' 에서 바꾸면 그 값(data/mode.json)이 이 값보다 우선합니다.
# 증권사 서버(모의/실전)는 모드에 맞춰 자동으로 고릅니다.
TRADING_MODE=dry

# ── 증권사 ──
# 국내: nh(나무증권, 기본) | kis(한국투자증권) | toss(토스증권)
BROKER=nh
# 미국: nh | toss  (비우면 국내와 같은 증권사, 국내가 kis 면 nh)
# BROKER_US=nh

# ── NH투자증권 나무 Open API (www.nhplug.com/intro 에서 앱키 발급 + 모의투자 신청) ──
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
# 서버는 실행 모드에 맞춰 자동 선택(mock→moapi, live→api). dry 일 때만 이 값을 씁니다.
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443
# 토큰은 모의투자도 운영 서버에서 발급 — 바꾸지 마세요
NHPLUG_AUTH_URL=https://api.nhplug.com:8443
# 계좌가 여러 개일 때만 지정 (비우면 모의투자/실계좌에 맞는 계좌 자동 선택)
# 지정한 계좌가 지금 모드(모의/실계좌)의 계좌가 아니면 무시하고 자동 선택합니다.
NHPLUG_ACCOUNT=
# 모의/실계좌 계좌를 따로 고정하려면
# NHPLUG_ACCOUNT_MOCK=
# NHPLUG_ACCOUNT_LIVE=
# 미국 주식을 다른 계좌로 할 때만 (비우면 위와 같은 계좌)
# NHPLUG_ACCOUNT_US=

# ── AI API 키 — 쓸 것만 넣으면 됩니다 (어떤 AI를 쓸지는 웹 설정 또는 config.toml) ──
# Claude   : console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini   : aistudio.google.com → Get API key
GEMINI_API_KEY=
# ChatGPT  : platform.openai.com → API keys  (ChatGPT Plus 구독과는 별도 결제)
OPENAI_API_KEY=
# AI_PROVIDER=gemini   # config.toml 대신 여기서 덮어쓰기 (claude/gemini/openai/consensus)

# ── 실계좌 안전장치 ──
# .env 의 TRADING_MODE=live 로 쓸 때 필요 (웹에서 확인 절차를 거쳐 바꾸면 없어도 됨)
# I_UNDERSTAND_REAL_MONEY=yes
# 웹에서 실계좌로 바꾸는 기능을 아예 막으려면
# WEB_LIVE_SWITCH=off
# 웹에서 앱키·AI 키 등 연결 정보를 바꾸는 기능을 막으려면
# WEB_ENV_EDIT=off
# 웹에서 업데이트(GitHub 최신 버전 적용)를 막으려면
# WEB_UPDATE=off

# ── 웹 관리 화면 (python -m web.app) ──
# 8자 이상 필수 (비어 있으면 웹이 시작되지 않음) — `python run.py passwd` 로 정하면 편해요
WEB_PASSWORD=
WEB_PORT=8080
# 패스키 로그인용 도메인 — 프록시가 Host 를 바꿀 때만 (예: stock.example.com)
# WEB_PUBLIC_HOST=

# ── (선택) 한국투자증권으로 쓰려면 BROKER=kis 와 아래 값을 넣으세요 ──
# KIS_SERVER=mock          # dry 일 때만 사용 (mock/live 모드면 그 서버로 자동)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT=12345678-01
# KIS 는 모의·실전 앱키가 다릅니다. 웹에서 모드를 오가려면 환경별로 넣으세요 (있으면 우선):
# KIS_MOCK_APP_KEY= / KIS_MOCK_APP_SECRET= / KIS_MOCK_ACCOUNT=
# KIS_LIVE_APP_KEY= / KIS_LIVE_APP_SECRET= / KIS_LIVE_ACCOUNT=

# ── (선택) 토스증권 — BROKER=toss 또는 BROKER_US=toss ──
# 토스증권 PC웹 로그인 → 설정 → Open API 에서 발급 + 이 서버의 공인 IP 를 허용 IP 로 등록
# ⚠ 토스는 모의투자가 없습니다: TRADING_MODE 는 dry(주문 없음) 또는 live 만 가능
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
# TOSS_ACCOUNT_SEQ=          # 계좌가 여러 개일 때만 (python run.py accounts 로 확인)

# ── (선택) 알림 — 웹 설정 → 알림에서 연결하는 게 편해요 ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# KAKAO_REST_KEY=
# KAKAO_CLIENT_SECRET=
